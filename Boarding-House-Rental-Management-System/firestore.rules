rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isLandlord() {
      return signedIn() && accountRole() in ['landlord', 'owner', 'caretaker'];
    }

    function ownsTenant(tenantId) {
      return signedIn()
        && exists(/databases/$(database)/documents/tenants/$(tenantId))
        && get(/databases/$(database)/documents/tenants/$(tenantId)).data.user_id == request.auth.uid;
    }

    function ownsLease(leaseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/leases/$(leaseId))
        && ownsTenant(get(/databases/$(database)/documents/leases/$(leaseId)).data.tenant_id);
    }

    function ownsInvoice(invoiceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/invoices/$(invoiceId))
        && ownsLease(get(/databases/$(database)/documents/invoices/$(invoiceId)).data.lease_id);
    }

    function validTenantSignup(tenantId) {
      return signedIn()
        && tenantId == 'tenant-' + request.auth.uid
        && request.resource.data.id == tenantId
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id', 'user_id', 'first_name', 'last_name', 'initials', 'phone', 'avatar_color',
          'account_status', 'registered_at'
        ])
        && request.resource.data.account_status == 'pending'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'tenant';
    }

    match /users/{userId} {
      allow get: if isLandlord() || (signedIn() && request.auth.uid == userId);
      allow list: if isLandlord();
      allow create: if isLandlord()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.id == userId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.role == 'tenant'
          && request.resource.data.keys().hasOnly(['id', 'email', 'role', 'created_at']));
      allow update: if isLandlord()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.id == userId
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'created_at', 'name', 'tenant_id'
          ]));
      allow delete: if isLandlord();
    }

    match /staff_profiles/{userId} {
      allow get: if isLandlord() || (signedIn() && request.auth.uid == userId);
      allow list: if isLandlord();
      allow write: if isLandlord();
    }

    match /tenants/{tenantId} {
      allow get, list: if isLandlord() || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isLandlord() || validTenantSignup(tenantId);
      allow update: if isLandlord()
        || (ownsTenant(tenantId)
          && request.resource.data.user_id == resource.data.user_id
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'account_status', 'approved_at', 'approved_by', 'rejected_at', 'rejection_reason'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'first_name', 'last_name', 'initials', 'phone', 'avatar_color', 'emergency_contact'
          ]));
      allow delete: if isLandlord();
    }

    match /boarding_houses/{houseId} {
      allow read: if signedIn();
      allow write: if isLandlord();
    }

    match /room_types/{typeId} {
      allow read: if signedIn();
      allow write: if isLandlord();
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, update, delete: if isLandlord();
    }

    match /leases/{leaseId} {
      allow read: if isLandlord() || ownsTenant(resource.data.tenant_id);
      allow write: if isLandlord();
    }

    match /utility_readings/{readingId} {
      allow read, write: if isLandlord();
    }

    match /invoices/{invoiceId} {
      allow read: if isLandlord() || ownsLease(resource.data.lease_id);
      allow write: if isLandlord();
    }

    match /payments/{paymentId} {
      allow read: if isLandlord() || ownsInvoice(resource.data.invoice_id);
      allow write: if isLandlord();
    }

    match /complaints/{complaintId} {
      allow read: if isLandlord() || ownsTenant(resource.data.tenant_id);
      allow create: if isLandlord()
        || (ownsTenant(request.resource.data.tenant_id)
          && request.resource.data.id == complaintId
          && request.resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/rooms/$(request.resource.data.room_id)));
      allow update: if isLandlord();
      allow delete: if isLandlord();
    }

    match /room_change_requests/{requestId} {
      allow read: if isLandlord() || ownsTenant(resource.data.tenant_id);
      allow create: if ownsTenant(request.resource.data.tenant_id)
          && request.resource.data.id == requestId
          && request.resource.data.status == 'pending'
          && exists(/databases/$(database)/documents/rooms/$(request.resource.data.requested_room_id))
          && get(/databases/$(database)/documents/rooms/$(request.resource.data.requested_room_id)).data.status == 'vacant';
      allow update: if isLandlord();
      allow delete: if isLandlord();
    }

    match /room_assignment_requests/{requestId} {
      allow read, write: if isLandlord();
    }

    match /due_date_extension_requests/{requestId} {
      allow read: if isLandlord() || ownsTenant(resource.data.tenant_id);
      allow create: if isLandlord()
        || (ownsTenant(request.resource.data.tenant_id)
          && request.resource.data.id == requestId
          && request.resource.data.status == 'pending'
          && ownsInvoice(request.resource.data.invoice_id)
          && request.resource.data.keys().hasOnly([
            'id', 'tenant_id', 'invoice_id', 'current_due_date', 'requested_due_date', 'reason', 'status', 'requested_at'
          ]));
      allow update: if isLandlord();
      allow delete: if isLandlord();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update: if isLandlord() && request.resource.data.author_user_id == request.auth.uid;
      allow delete: if isLandlord();
      
      // Subcollection for announcement comments
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() 
          && request.resource.data.author_user_id == request.auth.uid;
        allow update: if signedIn() 
          && resource.data.author_user_id == request.auth.uid;
        allow delete: if isLandlord() 
          || (signedIn() && resource.data.author_user_id == request.auth.uid);
      }
    }

    match /tenant_notifications/{notificationId} {
      allow read: if isLandlord() || ownsTenant(resource.data.tenant_id);
      allow create: if isLandlord();
      allow update: if isLandlord() 
        || (ownsTenant(resource.data.tenant_id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isLandlord();
    }

    match /payment_proofs/{proofId} {
      allow read: if isLandlord() || ownsTenant(resource.data.tenant_id);
      allow create: if ownsTenant(request.resource.data.tenant_id)
        && request.resource.data.id == proofId
        && request.resource.data.status == 'pending'
        && ownsInvoice(request.resource.data.invoice_id)
        && request.resource.data.keys().hasOnly([
          'id', 'tenant_id', 'invoice_id', 'amount', 'payment_date', 'payment_method',
          'reference_no', 'proof_image_url', 'notes', 'status', 'submitted_at',
          'reviewed_at', 'reviewed_by_user_id', 'rejection_reason'
        ]);
      allow update: if isLandlord() 
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewed_at', 'reviewed_by_user_id', 'rejection_reason'
        ]);
      allow delete: if isLandlord();
    }
  }
}
